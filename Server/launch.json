{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach by Process ID",
            "processId": "${command:PickProcess}",
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "sourceMaps": true,
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Server (Dev)",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}/Server",
            "envFile": "${workspaceFolder}/Server/.env",
            "console": "externalTerminal",
            "windows": {
                "console": "externalTerminal",
            },
            "resolveSourceMapLocations": [
                "${workspaceFolder}/Server/**",
                "!**/node_modules/**"
            ],
            "sourceMaps": true,
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch RPG",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/Game/rpg-game/dist/server/main.mjs"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch CRUD",
            "url": "http://localhost:8080", // Vite's default port
            "webRoot": "${workspaceFolder}/Client/CRUD",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "/@fs/*": "${webRoot}/*",
                "/@vite/*": "${webRoot}/node_modules/*",
                "/src/*": "${webRoot}/src/*"
            }
        }
    ]
}